// Cloudflare Workers 静态资源部署：npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mhwi-ai",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web"
  },
  // 只通过自定义域名访问，不开 workers.dev 与预览地址
  "routes": [{ "pattern": "mhwi.helsincy.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
